# Скопируйте в .env и подставьте свои ключи Yandex AI Studio.
# .env в .gitignore — секреты в git не попадают.
# Без ключа детерминированное ядро (ветка А, python -m factory) работает полностью;
# литература/schema_bootstrap/judge/--polish требуют ключ и без него мягко отключаются.
YANDEX_API_KEY=ваш_api_ключ
YANDEX_FOLDER_ID=ваш_folder_id
